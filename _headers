# Cloudflare Pages response headers. GitHub Pages ignores this file.

# The site lives at www.simpliaspain.com. Its pages.dev aliases (the
# production alias and every preview such as main.<project>.pages.dev)
# must never be indexed, or Google would find a second copy of the site.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:branch.:project.pages.dev/*
  X-Robots-Tag: noindex

# Hashed bundles never change under the same name: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
